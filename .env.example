# Primary database (PostgreSQL via docker-compose). Host port is 5433 to avoid clashes.
DATABASE_URL="postgresql://bian:bian@localhost:5433/bian_mapper?schema=public"

# Minimal JWT auth for the POC. Change in any shared/deployed environment.
JWT_SECRET="dev-only-change-me"

# Backend port
API_PORT=3000

# Frontend dev server port
WEB_PORT=5173
VITE_API_URL="http://localhost:3000/api/v1"
